# GENERATED by scripts/apply-theme.sh from theme/palette.sh.
# Layout lives in theme/templates/hypr/hyprlock.conf.tmpl.
# Docs: https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/

general {
    hide_cursor = true
    ignore_empty_input = true
    fail_timeout = 1500
}

animations {
    enabled = true
    bezier = ease, 0.25, 1, 0.5, 1
    animation = fadeIn, 1, 4, ease
    animation = fadeOut, 1, 4, ease
    animation = inputFieldDots, 1, 2, ease
}

background {
    monitor =
    path = screenshot
    color = rgb({{bg.hex}})
    blur_passes = 3
    blur_size = 6
    brightness = 0.6
    vibrancy = 0.15
}

# Clock
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb({{fg.hex}})
    font_size = 96
    font_family = {{font_ui}} Light
    position = 0, 160
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = rgb({{fg_dim.hex}})
    font_size = 16
    font_family = {{font_ui}}
    position = 0, 70
    halign = center
    valign = center
}

# Thin accent rule between date and input
shape {
    monitor =
    size = 48, 2
    color = rgb({{accent.hex}})
    rounding = 1
    position = 0, 30
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 48
    outline_thickness = {{border}}
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    outer_color = rgba({{overlay.hex}}ee)
    inner_color = rgba({{bg_alt.hex}}cc)
    font_color = rgb({{fg.hex}})
    font_family = {{font_ui}}
    fade_on_empty = false
    placeholder_text = <span foreground="#{{fg_dim.hex}}">$USER</span>
    rounding = {{radius}}
    check_color = rgb({{accent.hex}})
    fail_color = rgb({{urgent.hex}})
    fail_text = <i>$FAIL</i>
    capslock_color = rgb({{warning.hex}})
    position = 0, -30
    halign = center
    valign = center
}

# Hint
label {
    monitor =
    text = locked
    color = rgb({{muted.hex}})
    font_size = 10
    font_family = {{font_mono}}
    position = 0, 30
    halign = center
    valign = bottom
}
