/* GENERATED by scripts/apply-theme.sh from theme/templates/wlogout/style.css.tmpl.
 * wlogout is optional (install with --wlogout). Text-only buttons, no icon files. */

* {
    font-family: "{{font_ui}}", sans-serif;
    background-image: none;
    box-shadow: none;
    transition: background-color 150ms ease, color 150ms ease;
}

window {
    background-color: rgba({{bg.rgb}}, 0.82);
}

button {
    color: {{fg_dim}};
    font-size: 15pt;
    background-color: rgba({{bg_alt.rgb}}, 0.9);
    border: 1px solid {{overlay}};
    border-radius: {{radius}}px;
    margin: 6px;
}

button:focus,
button:hover {
    color: {{bg}};
    background-color: {{accent}};
    border-color: {{accent}};
    outline-style: none;
}

#shutdown:hover, #shutdown:focus {
    background-color: {{urgent}};
    border-color: {{urgent}};
}
