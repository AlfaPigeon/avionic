/* GENERATED by scripts/apply-theme.sh from theme/templates/wlogout/style.css.tmpl.
 * wlogout is optional (install with --wlogout). Text-only square buttons. */

* {
    font-family: "{{font_mono}}", monospace;
    background-image: none;
    box-shadow: none;
    border-radius: {{radius}}px;
    transition: background-color 120ms ease, color 120ms ease;
}

window {
    background-color: {{bg}};
}

button {
    color: {{fg_dim}};
    font-size: 14pt;
    background-color: {{bg_alt}};
    border: {{border}}px solid {{overlay}};
    margin: 6px;
}

button:focus,
button:hover {
    color: {{fg}};
    background-color: {{surface}};
    border-color: {{fg_dim}};
    outline-style: none;
}

#shutdown:hover, #shutdown:focus {
    color: {{urgent}};
    border-color: {{urgent}};
}
