/* GENERATED by scripts/apply-theme.sh from theme/templates/swayosd/style.css.tmpl.
 * On-screen display for volume / brightness keys. Square, solid, quiet. */

window#osd {
    border-radius: {{radius}}px;
    border: {{border}}px solid {{overlay}};
    background: {{bg_alt}};
}

window#osd #container {
    margin: 12px 16px;
}

window#osd image,
window#osd label {
    color: {{fg}};
    font-family: "{{font_mono}}", monospace;
}

window#osd progressbar:disabled,
window#osd image:disabled {
    opacity: 0.45;
}

window#osd progressbar,
window#osd segmentedprogress {
    min-height: 4px;
    border-radius: {{radius}}px;
    background: transparent;
    border: none;
}

window#osd trough,
window#osd segment {
    min-height: inherit;
    border-radius: {{radius}}px;
    border: none;
    background: {{overlay}};
}

window#osd progress,
window#osd segment.active {
    min-height: inherit;
    border-radius: {{radius}}px;
    border: none;
    background: {{fg}};
}

window#osd segment {
    margin-left: 4px;
}
window#osd segment:first-child {
    margin-left: 0;
}
