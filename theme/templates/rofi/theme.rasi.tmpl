/* GENERATED by scripts/apply-theme.sh from theme/templates/rofi/theme.rasi.tmpl.
 * Avionic: square panel, 1px rules, no amber (selection is a quiet text highlight). */

* {
    bg:          {{bg_alt}};
    surface:     {{surface}};
    overlay:     {{overlay}};
    fg:          {{fg}};
    fg-dim:      {{fg_dim}};
    muted:       {{muted}};
    urgent:      {{urgent}};

    font:             "{{font_ui}} {{font_size}}";
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    width:            560px;
    background-color: @bg;
    border:           {{border}}px;
    border-color:     @overlay;
    border-radius:    {{radius}}px;
}

mainbox {
    children: [ inputbar, message, listview ];
}

inputbar {
    padding:          12px 14px;
    spacing:          12px;
    background-color: @bg;
    border:           0 0 {{border}}px 0;
    border-color:     @overlay;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @muted;
    font:       "{{font_mono}} {{font_size}}";
}

entry {
    placeholder:       "search";
    placeholder-color: @muted;
    cursor:            text;
}

message {
    padding:          8px 14px;
    border:           0 0 {{border}}px 0;
    border-color:     @overlay;
}
textbox { text-color: @fg-dim; }

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    padding:      4px 0;
}

element {
    padding:       8px 14px;
    spacing:       12px;
    border:        0 0 0 2px;
    border-color:  transparent;
    border-radius: {{radius}}px;
}
element normal.normal, element alternate.normal { text-color: @fg-dim; }
element selected.normal {
    background-color: @surface;
    text-color:       @fg;
    border-color:     @fg-dim;
}
element normal.urgent, element alternate.urgent, element selected.urgent { text-color: @urgent; }
element normal.active, element alternate.active { text-color: @fg; }

element-icon {
    size:       20px;
    text-color: inherit;
}
element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}
