/* GENERATED by scripts/apply-theme.sh from theme/templates/rofi/theme.rasi.tmpl.
 * Edit the template (layout) or theme/palette.sh (colors), then re-run apply-theme. */

* {
    bg:          {{bg}}e6;
    bg-alt:      {{bg_alt}};
    surface:     {{surface}};
    overlay:     {{overlay}};
    fg:          {{fg}};
    fg-dim:      {{fg_dim}};
    muted:       {{muted}};
    accent:      {{accent}};
    urgent:      {{urgent}};

    font:             "{{font_ui}} {{font_size}}";
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    width:            560px;
    background-color: @bg;
    border:           1px;
    border-color:     @overlay;
    border-radius:    {{radius}}px;
}

mainbox {
    padding:  14px;
    spacing:  10px;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding:          10px 12px;
    spacing:          10px;
    background-color: @surface;
    border:           0 0 2px 0;
    border-color:     @accent;
    border-radius:    {{radius}}px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "{{font_mono}} {{font_size}}";
}

entry {
    placeholder:       "search";
    placeholder-color: @muted;
    cursor:            text;
}

message {
    padding:          8px 12px;
    background-color: @bg-alt;
    border-radius:    {{radius}}px;
}
textbox { text-color: @fg-dim; }

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: {{radius}}px;
}
element normal.normal, element alternate.normal { text-color: @fg-dim; }
element selected.normal {
    background-color: @surface;
    text-color:       @fg;
    border:           0 0 0 2px;
    border-color:     @accent;
}
element normal.urgent, element alternate.urgent { text-color: @urgent; }
element normal.active, element alternate.active { text-color: @accent; }

element-icon {
    size:       22px;
    text-color: inherit;
}
element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}
