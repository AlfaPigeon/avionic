/* GENERATED by scripts/apply-theme.sh from theme/templates/swaync/style.css.tmpl.
 * swaync loads its packaged stylesheet first; this file only overrides it. */

:root {
    --cc-bg: rgba({{bg.rgb}}, 0.88);

    --noti-border-color: rgba({{overlay.rgb}}, 0.9);
    --noti-bg: {{bg_alt.rgb}};
    --noti-bg-alpha: 0.92;
    --noti-bg-darker: {{bg}};
    --noti-bg-hover: {{surface}};
    --noti-bg-focus: rgba({{surface.rgb}}, 0.8);
    --noti-close-bg: {{surface}};
    --noti-close-bg-hover: {{overlay}};

    --text-color: {{fg}};
    --text-color-disabled: {{muted}};

    --bg-selected: {{accent}};

    --border-radius: {{radius}}px;
    --font-size-body: {{font_size}}pt;
    --font-size-summary: {{font_size}}pt;
}

* {
    font-family: "{{font_ui}}", sans-serif;
}

.notification-row .notification-background .notification {
    border: 1px solid var(--noti-border-color);
}

/* Critical notifications get a red edge */
.notification-row .notification-background .notification.critical {
    border-left: 3px solid {{urgent}};
}

.notification .summary { font-weight: 600; }
.notification .body,
.notification .time { color: {{fg_dim}}; }

.control-center {
    border: 1px solid rgba({{overlay.rgb}}, 0.9);
    border-radius: {{radius}}px;
}

.widget-title > label {
    font-size: 1.2em;
    font-weight: 600;
}
.widget-title > button {
    border-radius: {{radius}}px;
    background: {{surface}};
    color: {{fg}};
}
.widget-title > button:hover { background: {{overlay}}; }

.widget-dnd > switch:checked { background: {{accent}}; }

.control-center-list-placeholder { color: {{muted}}; }
