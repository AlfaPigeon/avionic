/* GENERATED by scripts/apply-theme.sh from theme/templates/waybar/style.css.tmpl.
 * Edit the template (layout) or theme/palette.sh (colors), then re-run apply-theme.
 *
 * Avionic: a flat instrument strip. Square modules, 1px rules, quiet text.
 * Amber appears only on the active workspace. */

@define-color bg         {{bg}};
@define-color bg_alt     {{bg_alt}};
@define-color surface    {{surface}};
@define-color overlay    {{overlay}};
@define-color fg         {{fg}};
@define-color fg_dim     {{fg_dim}};
@define-color muted      {{muted}};
@define-color accent     {{accent}};
@define-color urgent     {{urgent}};
@define-color success    {{success}};

* {
    font-family: "{{font_mono}}", monospace;
    font-size: {{font_size}}pt;
    min-height: 0;
    border: none;
    border-radius: {{radius}}px;
    box-shadow: none;
    text-shadow: none;
}

window#waybar {
    background: @bg_alt;
    border-bottom: {{border}}px solid @overlay;
    color: @fg_dim;
}

tooltip {
    background: @surface;
    border: {{border}}px solid @overlay;
}
tooltip label { color: @fg; padding: 2px 4px; }

/* Every module is a square cell separated by a thin rule */
#custom-launcher, #workspaces, #submap, #window, #clock, #tray, #cpu, #memory,
#wireplumber, #network, #bluetooth, #battery, #custom-notifications, #custom-power {
    padding: 0 10px;
    color: @fg_dim;
}

#tray, #cpu, #memory, #wireplumber, #network, #bluetooth, #battery,
#custom-notifications, #custom-power {
    border-left: {{border}}px solid @overlay;
}

#cpu:hover, #memory:hover, #wireplumber:hover, #network:hover, #bluetooth:hover,
#battery:hover, #custom-notifications:hover, #custom-power:hover, #clock:hover,
#custom-launcher:hover {
    background: @surface;
    color: @fg;
}

#custom-launcher {
    color: @fg;
    padding: 0 14px;
    border-right: {{border}}px solid @overlay;
}

/* Workspaces: square cells; the active one is the single amber readout */
#workspaces {
    padding: 0;
    border-right: {{border}}px solid @overlay;
}
#workspaces button {
    color: @muted;
    padding: 0 10px;
    margin: 0;
    background: transparent;
    border-bottom: 2px solid transparent;
}
#workspaces button:hover {
    background: @surface;
    color: @fg;
}
#workspaces button.active {
    color: @accent;
    background: @surface;
    border-bottom: 2px solid @accent;
}
#workspaces button.urgent {
    color: @urgent;
    border-bottom: 2px solid @urgent;
}

#submap {
    color: @fg;
    background: @surface;
    border-right: {{border}}px solid @overlay;
}

#window { color: @muted; }

#clock {
    color: @fg;
    letter-spacing: 1px;
}

#tray > .needs-attention { color: @urgent; }

#wireplumber.muted, #bluetooth.off, #bluetooth.disabled, #network.disconnected { color: @muted; }
#battery.charging, #battery.plugged { color: @success; }
#battery.warning:not(.charging) { color: @fg; }
#battery.critical:not(.charging) { color: @urgent; }

#custom-notifications.notification,
#custom-notifications.inhibited-notification { color: @fg; }
#custom-notifications.dnd-none,
#custom-notifications.dnd-notification { color: @muted; }

#custom-power {
    color: @muted;
    padding: 0 14px 0 12px;
}
#custom-power:hover { color: @urgent; }
