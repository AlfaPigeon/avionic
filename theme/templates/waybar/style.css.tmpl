/* GENERATED by scripts/apply-theme.sh from theme/templates/waybar/style.css.tmpl.
 * Edit the template (layout) or theme/palette.sh (colors), then re-run apply-theme. */

@define-color bg         {{bg}};
@define-color bg_alt     {{bg_alt}};
@define-color surface    {{surface}};
@define-color overlay    {{overlay}};
@define-color fg         {{fg}};
@define-color fg_dim     {{fg_dim}};
@define-color muted      {{muted}};
@define-color accent     {{accent}};
@define-color accent_alt {{accent_alt}};
@define-color urgent     {{urgent}};
@define-color warning    {{warning}};
@define-color success    {{success}};

* {
    font-family: "{{font_ui}}", "{{font_mono}}", sans-serif;
    font-size: {{font_size}}pt;
    min-height: 0;
    border: none;
    border-radius: 0;
}

window#waybar {
    background: rgba({{bg_alt.rgb}}, 0.78);
    border: 1px solid rgba({{overlay.rgb}}, 0.9);
    border-radius: {{radius}}px;
    color: @fg;
}

tooltip {
    background: rgba({{bg.rgb}}, 0.96);
    border: 1px solid @overlay;
    border-radius: {{radius}}px;
}
tooltip label { color: @fg; padding: 2px 4px; }

/* Shared module shape: quiet text, small pill on hover */
#custom-launcher, #workspaces, #submap, #window, #clock, #tray, #cpu, #memory,
#wireplumber, #network, #bluetooth, #battery, #custom-notifications, #custom-power {
    padding: 0 10px;
    margin: 4px 0;
    color: @fg_dim;
    border-radius: {{radius}}px;
    transition: background-color 150ms ease, color 150ms ease;
}

#cpu:hover, #memory:hover, #wireplumber:hover, #network:hover, #bluetooth:hover,
#battery:hover, #custom-notifications:hover, #clock:hover {
    background: rgba({{surface.rgb}}, 0.9);
    color: @fg;
}

#custom-launcher {
    color: @accent;
    font-family: "{{font_mono}}";
    font-size: {{font_size}}pt;
    padding: 0 12px 0 14px;
}

/* Workspaces: thin pills; the active one carries the accent */
#workspaces { padding: 0 4px; }
#workspaces button {
    color: @muted;
    padding: 0 8px;
    margin: 3px 2px;
    border-radius: {{radius}}px;
    background: transparent;
    box-shadow: none;
}
#workspaces button:hover {
    background: rgba({{surface.rgb}}, 0.9);
    color: @fg;
}
#workspaces button.active {
    color: @bg;
    background: @accent;
}
#workspaces button.urgent {
    color: @bg;
    background: @urgent;
}

#submap {
    color: @bg;
    background: @warning;
}

#window { color: @fg_dim; }
window#waybar.empty #window { color: @muted; }

#clock {
    color: @fg;
    font-weight: 600;
    letter-spacing: 1px;
}

#tray > .needs-attention { background: rgba({{urgent.rgb}}, 0.25); }

#wireplumber.muted, #bluetooth.off, #bluetooth.disabled, #network.disconnected { color: @muted; }
#bluetooth.connected { color: @accent; }
#battery.charging, #battery.plugged { color: @success; }
#battery.warning:not(.charging) { color: @warning; }
#battery.critical:not(.charging) {
    color: @bg;
    background: @urgent;
}

#custom-notifications.notification,
#custom-notifications.inhibited-notification { color: @accent; }
#custom-notifications.dnd-none,
#custom-notifications.dnd-notification { color: @muted; }

#custom-power {
    color: @urgent;
    padding: 0 14px 0 10px;
}
#custom-power:hover {
    background: rgba({{urgent.rgb}}, 0.18);
}
