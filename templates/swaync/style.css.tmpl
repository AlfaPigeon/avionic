/* GENERATED by scripts/apply-theme.sh from templates/swaync/style.css.tmpl.
 * swaync loads its packaged stylesheet first; this file only overrides it.
 * {{theme_name}}: square, solid, 1px rules, no accent. */

:root {
    --cc-bg: {{bg_alt}};

    --noti-border-color: {{overlay}};
    --noti-bg: {{bg_alt.rgb}};
    --noti-bg-alpha: 1;
    --noti-bg-darker: {{bg}};
    --noti-bg-hover: {{surface}};
    --noti-bg-focus: {{surface}};
    --noti-close-bg: {{surface}};
    --noti-close-bg-hover: {{overlay}};

    --text-color: {{fg}};
    --text-color-disabled: {{muted}};

    --bg-selected: {{overlay}};

    --border: {{border}}px solid {{overlay}};
    --border-radius: {{radius}}px;
    --notification-shadow: none;
    --font-size-body: {{font_size}}pt;
    --font-size-summary: {{font_size}}pt;
}

* {
    font-family: "{{font_ui}}", sans-serif;
    border-radius: {{radius}}px;
    box-shadow: none;
}

.notification-row .notification-background .notification {
    border: {{border}}px solid {{overlay}};
}

/* Critical notifications get a red left rule */
.notification-row .notification-background .notification.critical {
    border-left: 3px solid {{urgent}};
}

.notification .summary { font-weight: 600; }
.notification .body { color: {{fg_dim}}; }
.notification .time {
    color: {{muted}};
    font-family: "{{font_mono}}", "{{font_term}}", monospace;
}

.control-center {
    border: {{border}}px solid {{overlay}};
}

.widget-title > label {
    font-size: 1.1em;
    font-weight: 600;
}
.widget-title > button {
    background: {{surface}};
    color: {{fg}};
    border: {{border}}px solid {{overlay}};
}
.widget-title > button:hover { background: {{overlay}}; }

.widget-dnd > switch { border: {{border}}px solid {{overlay}}; }
.widget-dnd > switch:checked { background: {{fg_dim}}; }
.widget-dnd > switch slider { background: {{fg}}; }

.control-center-list-placeholder { color: {{muted}}; }
