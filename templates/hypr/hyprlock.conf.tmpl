# GENERATED by scripts/apply-theme.sh from themes/{{theme}}/palette.sh.
# Layout lives in templates/hypr/hyprlock.conf.tmpl.
# Docs: https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/
# The wallpaper, a mono readout clock, one square input. No blur.

general {
    hide_cursor = true
    ignore_empty_input = true
    fail_timeout = 1500
}

animations {
    enabled = true
    bezier = ease, 0.25, 1, 0.5, 1
    animation = fadeIn, 1, 3, ease
    animation = fadeOut, 1, 3, ease
    animation = inputFieldDots, 1, 2, ease
}

background {
    monitor =
    path = {{wallpaper}}
    color = rgb({{bg.hex}})
    blur_passes = 0
}

# Clock readout
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb({{fg.hex}})
    font_size = 72
    font_family = {{font_mono}}
    position = 0, 170
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] {{lock_date}}
    color = rgb({{muted.hex}})
    font_size = 11
    font_family = {{font_mono}}
    position = 0, 95
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 300, 44
    outline_thickness = {{border}}
    dots_size = 0.18
    dots_spacing = 0.4
    dots_center = true
    dots_rounding = {{radius}}
    outer_color = rgb({{overlay.hex}})
    inner_color = rgb({{bg_alt.hex}})
    font_color = rgb({{fg.hex}})
    font_family = {{font_mono}}
    fade_on_empty = false
    placeholder_text = <span foreground="#{{muted.hex}}">$USER</span>
    rounding = {{radius}}
    check_color = rgb({{accent_alt.hex}})
    check_text = <span foreground="#{{fg_dim.hex}}">checking</span>
    fail_color = rgb({{urgent.hex}})
    fail_text = <span foreground="#{{urgent.hex}}">$FAIL</span>
    capslock_color = rgb({{warning.hex}})
    position = 0, -150
    halign = center
    valign = center
}
