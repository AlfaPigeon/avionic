// GENERATED by scripts/apply-theme.sh from templates/quickshell/Theme.qml.tmpl.
// Edit themes/<name>/palette.sh (values) or the template, then re-run apply-theme.
// Sizes follow Designer's bar specs, in logical pixels.
pragma Singleton

import QtQuick
import Quickshell

Singleton {
    readonly property string name: "{{theme_name}}"
    readonly property string bar: "{{bar}}"            // which layout under themes/ draws the bar

    // Palette
    readonly property color bg:        "{{bg}}"
    readonly property color bgAlt:     "{{bg_alt}}"     // bar fill
    readonly property color surface:   "{{surface}}"    // hover, active cell, popups
    readonly property color overlay:   "{{overlay}}"    // every rule, outline and track
    readonly property color fg:        "{{fg}}"         // values
    readonly property color fgDim:     "{{fg_dim}}"     // window title
    readonly property color muted:     "{{muted}}"      // labels
    readonly property color accent:    "{{accent}}"
    readonly property color accentAlt: "{{accent_alt}}"
    readonly property color urgent:    "{{urgent}}"     // critical readings, urgent workspace
    readonly property color warning:   "{{warning}}"
    readonly property color success:   "{{success}}"    // charging

    // Data ramp, low to high
    readonly property list<color> ramp: ["{{ramp_0}}", "{{ramp_1}}", "{{ramp_2}}", "{{ramp_3}}", "{{ramp_4}}", "{{ramp_5}}"]

    // Type
    readonly property string fontUi:   "{{font_ui}}"   // window title
    readonly property string fontMono: "{{font_mono}}" // every readout
    readonly property int valuePx: {{font_size}}        // values, workspace numbers, title
    readonly property int labelPx: valuePx - 1          // labels
    readonly property int clockPx: valuePx + 3          // HH:MM:SS

    // Frame (shared by every bar layout)
    readonly property int radius: {{radius}}
    readonly property int border: {{border}}
    readonly property int barHeight: 32                 // includes the 1px bottom rule
    readonly property int dividerInset: 7               // section dividers, from top and bottom
    readonly property int pad: 12                       // space around a divider
    readonly property int tapeCell: 34                  // avionic heading tape
    readonly property int hoverMs: 100                  // no animation longer than 120ms
}
