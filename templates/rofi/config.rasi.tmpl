/* GENERATED by scripts/apply-theme.sh from templates/rofi/config.rasi.tmpl.
 * rofi (2.x, native Wayland): launcher, clipboard, power menu, keybind list. */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "{{icon_theme}}";
    drun-display-format: "{name}";
    display-drun:        "apps";
    display-run:         "run";
    display-window:      "windows";
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    case-sensitive:      false;
    cycle:               true;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    terminal:            "kitty";
}

@theme "~/.config/rofi/theme.rasi"
